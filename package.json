{
  "name": "still",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:native": "npm run start -w still-native",
    "test:native": "npm test -w still-native",
    "test:native:ci": "npm run test:ci -w still-native",
    "lint:native": "npm run lint -w still-native",
    "lint:native:ci": "npm run lint:ci -w still-native",
    "format": "prettier . --write",
    "format:ci": "prettier . --check",
    "dev:web": "npm run dev -w still-web",
    "lint:web": "npm run lint -w still-web"
  }
}

{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "jest.virtualFolders": [
    {
      "name": "native",
      "rootPath": "apps/native",
      "jestCommandLine": "npm test -w still-native --"
    },
    {
      "name": "web",
      "rootPath": "apps/web",
      "jestCommandLine": "npm test -w still-web --"
    }
  ]
}

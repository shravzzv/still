// eas.json
{
  "build": {
    "preview": {
      "distribution": "internal",
      "extends": "production",
      "channel": "preview",
      "android": { "buildType": "apk" }
    },
    "production": {
      "node": "20.19.0",
      "channel": "production",
      "android": { "buildType": "apk" }
    },
    "development": {
      "extends": "production",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development-simulator"
    },
    "e2e-test": {
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
